--
-- Table structure for table `livres_auteur`
--

DROP TABLE IF EXISTS "livres_auteur" CASCADE;
CREATE TABLE "livres_auteur" (
  "id" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "nom" varchar(100) NOT NULL,
  "prenom" varchar(100) NOT NULL,
  "nationalite_id" integer NOT NULL,
  "anneeNaissance" integer DEFAULT NULL,
  PRIMARY KEY ("id")
);

--
-- Table structure for table `livres_editeur`
--

DROP TABLE IF EXISTS "livres_editeur" CASCADE;
CREATE TABLE "livres_editeur" (
  "id" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "nom" varchar(200) NOT NULL,
  "adresse" varchar(200) NOT NULL,
  PRIMARY KEY ("id")
);

--
-- Table structure for table `livres_genre`
--

DROP TABLE IF EXISTS "livres_genre" CASCADE;
CREATE TABLE "livres_genre" (
  "id" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "genre" varchar(50) NOT NULL,
  PRIMARY KEY ("id")
);

--
-- Table structure for table `livres_illustrateur`
--

DROP TABLE IF EXISTS "livres_illustrateur" CASCADE;
CREATE TABLE "livres_illustrateur" (
  "id" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "nom" varchar(100) NOT NULL,
  "prenom" varchar(100) NOT NULL,
  "nationalite_id" integer NOT NULL,
  PRIMARY KEY ("id")
);


--
-- Table structure for table `livres_livres`
--

DROP TABLE IF EXISTS "livres_livres" CASCADE;
CREATE TABLE "livres_livres" (
  "id" integer NOT NULL GENERATED BY DEFAULT AS IDENTITY,
  "numEdition" integer DEFAULT NULL,
  "numEditeur_id" integer NOT NULL,
  "anneePremiereEdition" integer NOT NULL,
  "titre" varchar(200) NOT NULL,
  "titreVo" varchar(200) DEFAULT NULL,
  "genre_id" integer NOT NULL,
  "typeLivre_id" integer NOT NULL,
  "dateSaisie" timestamp DEFAULT NULL,
  "collection" boolean NOT NULL,
  "dateDebutLecture" timestamp DEFAULT NULL,
  "dateFinLecture" timestamp DEFAULT NULL,
  "note" real DEFAULT NULL,
  "illustrateur_id" integer DEFAULT NULL,
  "auteur_id" integer DEFAULT NULL,
  "image" varchar(100) DEFAULT NULL,
  "description" varchar(4000) DEFAULT NULL,
  "commentaires" varchar(4000) DEFAULT NULL,
  "serie" varchar(300) DEFAULT NULL,
  "num_serie" integer DEFAULT NULL,
  "dedicace" varchar(100) DEFAULT NULL,
  "emprunteur" varchar(200) DEFAULT NULL,
  PRIMARY KEY ("id")
);


